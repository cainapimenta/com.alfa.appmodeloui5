<mvc:View
    controllerName="com.alfa.appmodeloui5.controller.Products"
    xmlns="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:p="sap.m.plugins"
>
    <m:Page
        id="page"
        title="{i18n>title}"
    >
        <Table
            rows="{/Products}"
            selectionMode="None"
        >
            <extension>
                <m:OverflowToolbar style="Clear">
                    <m:Title
                        id="title"
                        text="Products"
                    />
                </m:OverflowToolbar>
            </extension>
            <columns>
                <Column
                    resizable="false"
                    visible="true"
                >
                    <m:Label text="ID do Produto" />
                    <template>
                        <m:Label text="{ID}" />
                    </template>
                </Column>
                <Column
                    resizable="false"
                    visible="true"
                >
                    <m:Label text="Produto" />
                    <template>
                        <m:Label text="{Name}" />
                    </template>
                </Column>
                <Column
                    resizable="false"
                    visible="true"
                >
                    <m:Label text="Descrição" />
                    <template>
                        <m:Label text="{Description}" />
                    </template>
                </Column>
                <Column
                    resizable="false"
                    visible="true"
                >
                    <m:Label text="Avaliação" />
                    <template>
                        <m:Label text="{Rating}" />
                    </template>
                </Column>
                <Column
                    resizable="false"
                    visible="true"
                >
                    <m:Label text="Preço" />
                    <template>
                        <m:Label text="{Price}" />
                    </template>
                </Column>
                <Column
                    resizable="false"
                    width="5rem"
                    visible="{
                        path: 'user>/scopes', 
                        formatter: '.formatter.isUserAllowedToEdit'
                    }"
                >
                    <m:Label text="" />
                    <template>
                        <m:HBox
                            alignItems="Center"
                            justifyContent="Center"
                        >
                            <m:Button
                                icon="sap-icon://edit"
                                press="handleUpdateProduct"
                                type="Emphasized"
                            />
                        </m:HBox>
                    </template>
                </Column>
                <Column
                    resizable="false"
                    width="5rem"
                    visible="{
                        path: 'user>/scopes', 
                        formatter: '.formatter.isUserAllowedToEdit'
                    }"
                >
                    <m:Label text="" />
                    <template>
                        <m:HBox
                            alignItems="Center"
                            justifyContent="Center"
                        >
                            <m:Button
                                icon="sap-icon://delete"
                                press="handleDeleteProduct"
                                type="Negative"
                            />
                        </m:HBox>
                    </template>
                </Column>
            </columns>
        </Table>

        <!-- Footer -->
        <m:footer>
            <m:OverflowToolbar style="Clear">
                <m:ToolbarSpacer />

                <m:Button
                    text="Adicionar produto"
                    type="Emphasized"
                    icon="sap-icon://add"
                    iconFirst="false"
                    press="handleCreateProduct"
                    visible="{
                        path: 'user>/scopes', 
                        formatter: '.formatter.isUserAllowedToEdit'
                    }"
                />
            </m:OverflowToolbar>
        </m:footer>
    </m:Page>
</mvc:View>
